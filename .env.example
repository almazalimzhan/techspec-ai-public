# Text-generation LLM provider
LLM_PROVIDER=litellm
LLM_MODEL=gemma3-27b-32bit
LITELLM_BASE_URL=https://litellm-cloud.sk-ai.kz/v1
LITELLM_API_KEY=
ALEM_MODEL=astanahub/alemllm

# Local embedding provider
EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://127.0.0.1:11434

# Vector retrieval backend
VECTOR_BACKEND=qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=techspec_chunks
QDRANT_TIMEOUT_SECONDS=15

# Optional API protection. Leave empty for local demos.
API_AUTH_TOKEN=

# Optional Telegram bot. Leave empty unless running telegram_bot.py.
TELEGRAM_BOT_TOKEN=

# Runtime settings
SESSION_BACKEND=sqlite
SESSION_DB_PATH=.runtime/techspec.db
SESSION_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
VERIFY_TLS=true
USAGE_LOG_FILE=usage_logs.csv

# CORS for local frontend development
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173
